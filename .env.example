# ==============================================================================
# BLOG CORE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ==============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME="Blog Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL="${APP_URL}"
ASSET_URL=null

# Timezone & Localization
APP_TIMEZONE=UTC
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# ─────────────────────────────────────────────────────────────────────────────
# THEME SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
# Active theme - themes are located in resources/themes/{name}/
ACTIVE_THEME=classic
ACTIVE_THEME_ADMIN=classic

# ==============================================================================
# BRANDING CONFIGURATION
# ==============================================================================
# These values control site identity, SEO defaults, author metadata,
# and newsletter branding. Each deployment/client can customize them
# without modifying code.
# ==============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Site Identity
# ─────────────────────────────────────────────────────────────────────────────
BRANDING_SITE_NAME="My Blog"
BRANDING_TAGLINE="Content Platform"
BRANDING_SITE_DESCRIPTION="A modern content platform for sharing ideas and articles."
BRANDING_SITE_DOMAIN=${APP_URL}

# ─────────────────────────────────────────────────────────────────────────────
# Author Metadata (Used for SEO & Schema.org)
# ─────────────────────────────────────────────────────────────────────────────
BRANDING_AUTHOR_NAME="Site Author"
BRANDING_AUTHOR_NAME_EN="Site Author"
BRANDING_AUTHOR_TITLE="Content Creator"
BRANDING_AUTHOR_BIO="Content creator and blogger."
BRANDING_AUTHOR_AVATAR="images/avatar.jpg"

# ─────────────────────────────────────────────────────────────────────────────
# Social Media Links
# ─────────────────────────────────────────────────────────────────────────────
BRANDING_SOCIAL_TWITTER=
BRANDING_SOCIAL_TWITTER_HANDLE=
BRANDING_SOCIAL_LINKEDIN=
BRANDING_SOCIAL_FACEBOOK=
BRANDING_SOCIAL_INSTAGRAM=

# ─────────────────────────────────────────────────────────────────────────────
# SEO Defaults
# ─────────────────────────────────────────────────────────────────────────────
BRANDING_DEFAULT_KEYWORDS="blog, articles, content"
BRANDING_DEFAULT_OG_IMAGE="images/og-default.jpg"

# ─────────────────────────────────────────────────────────────────────────────
# Newsletter Branding
# ─────────────────────────────────────────────────────────────────────────────
NEWSLETTER_MAIL_FROM_ADDRESS=
NEWSLETTER_MAIL_FROM_NAME=

# ─────────────────────────────────────────────────────────────────────────────
# Blog Identity Mode
# ─────────────────────────────────────────────────────────────────────────────
# single = all posts shown as site owner
# multi  = posts shown with actual author
BLOG_IDENTITY_MODE=single

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (MySQL/MariaDB)
# ─────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blog
DB_USERNAME=root
DB_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# CACHE, SESSION & QUEUE
# ─────────────────────────────────────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# ─────────────────────────────────────────────────────────────────────────────
# REDIS (Optional - for caching/sessions in production)
# ─────────────────────────────────────────────────────────────────────────────
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# MAIL CONFIGURATION
# ==============================================================================
# 1. SYSTEM MAILER: For transactional emails (Password resets, verification)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# 2. NEWSLETTER MAILER: For bulk campaign emails (Resend, Brevo, Mailgun)
NEWSLETTER_MAILER=newsletter
NEWSLETTER_MAIL_HOST=
NEWSLETTER_MAIL_PORT=587
NEWSLETTER_MAIL_USERNAME=
NEWSLETTER_MAIL_PASSWORD=
NEWSLETTER_MAIL_ENCRYPTION=tls

# ─────────────────────────────────────────────────────────────────────────────
# AWS S3 (Optional - for cloud file storage)
# ─────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─────────────────────────────────────────────────────────────────────────────
# VITE (Frontend Assets)
# ─────────────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN USER (Required for database seeding)
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_NAME="Admin User"
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_password
DELETED_USER_EMAIL=deleted-user@local

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE reCAPTCHA v2
# ─────────────────────────────────────────────────────────────────────────────
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_THRESHOLD=0.5

# ==============================================================================
# PLAN & FEATURE FLAGS SYSTEM
# ==============================================================================
# USE_PLAN_SYSTEM=true  → Features are derived from CLIENT_PLAN (config/plans.php)
# USE_PLAN_SYSTEM=false → Features use FEATURE_XXX values directly (pure flags mode)
#
# OVERRIDES: When USE_PLAN_SYSTEM=true, leave a feature empty to inherit from 
# the plan. Set an explicit value (true/false) to override the plan for that feature.
# ==============================================================================

USE_PLAN_SYSTEM=true
CLIENT_PLAN=basic

# --- Core Features (Always-on by default, but overridable) ---
FEATURE_SEO=true
FEATURE_MEDIA=true

# --- Content Modules ---
FEATURE_THOUGHTS=
FEATURE_BOOKS=
FEATURE_KHUTAB=

# --- Media & VOD (Video on Demand) Modules ---
FEATURE_MEDIA_PAGES=
FEATURE_VOD_VIDEO=
FEATURE_VOD_AUDIO=
FEATURE_VOD_PLAYLISTS=

# --- Marketing & Engagement Modules ---
FEATURE_NEWSLETTER=
FEATURE_CONTACT=
FEATURE_LANDING=
FEATURE_DOWNLOAD=

# --- Administrative & System Modules ---
FEATURE_MANAGE_ADMINS=
FEATURE_ADVANCED_SEO=
# Set to true or false to manually override the business tier requirement
FEATURE_GENERAL_SETTINGS=

# ==============================================================================
# QUICK START CHECKLIST
# ==============================================================================
# [ ] Copy this file to .env
# [ ] Generate APP_KEY: php artisan key:generate
# [ ] Configure DB_* for your MySQL connection
# [ ] Set MAIL_* for transactional emails (Gmail works for dev)
# [ ] Set NEWSLETTER_MAIL_* for campaigns (or leave blank to use MAIL_*)
# [ ] Set ADMIN_* credentials for seeding
# [ ] Set BRANDING_* for site identity, author info, and SEO
# [ ] Run migrations: php artisan migrate --seed
# [ ] Start queue worker: php artisan queue:work
# [ ] Start dev server: php artisan serve
# ==============================================================================